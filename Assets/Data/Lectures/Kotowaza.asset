  steps:
  - clearType: 0
    targetGroups: []
    dialogueText: "\u305D\u308C\u3058\u3083\u3042\u3001<r=\u304D\u3087\u3046>\u4ECA\u65E5</r>\u306F\u3053\u3068\u308F\u3056\u306B\u3064\u3044\u3066<br><r=\u305B\u3064\u3081\u3044>\u8AAC\u660E</r>\u3057\u3066\u3044\u304F\u30B1\u30ED\u3002"
    isFrogHandLowered: 0
    playChalkSound: 1
    newBoardItems:
    - groupName: Title
      itemType: 0
      textContent: "<u>\u3053\u3068\u308F\u3056</u>"
      fontSize: 64
      overrideColor: 0
      textColor: {r: 0, g: 0, b: 0, a: 0}
      imageContent: {fileID: 0}
      imageScale: 0
      anchoredPosition: {x: 87, y: 431}
  - clearType: 0
    targetGroups: []
    dialogueText: "\u3053\u3068\u308F\u3056\u306F\u3001<r=\u3050\u305F\u3044\u308C\u3044>\u5177\u4F53\u4F8B</r>\u306B\u3042\u3066\u306F\u3081\u3066<br><r=\u304B\u3093\u304C>\u8003</r>\u3048\u308B\u306E\u304C<r=\u3060\u3044\u3058>\u5927\u4E8B</r>\u30B1\u30ED\u3002"
    isFrogHandLowered: 1
    playChalkSound: 1
    newBoardItems:
    - groupName: Content_1
      itemType: 0
      textContent: "\u30FB<r=\u306B\u3068>\u4E8C\u514E</r>\u3092<r=\u304A>\u8FFD</r>\u3046<r=\u3082\u306E>\u8005</r>\u306F<r=\u3044\u3063\u3068>\u4E00\u514E</r>\u3082<r=\u3048>\u5F97</r>\u305A\u2026<r=\u3069\u3046\u3058>\u540C\u6642</r>\u306B<r=\u3075\u305F>\u4E8C</r>\u3064\u306E<r=\u3082\u304F\u3072\u3087\u3046>\u76EE\u6A19</r>\u3092<r=\u304A>\u8FFD</r>\u3044\u304B\u3051\u3066<r=\u3057\u3063\u3071\u3044>\u5931\u6557</r>\u3059\u308B\u3053\u3068\u306E\u305F\u3068\u3048\n"
      fontSize: 36
      overrideColor: 0
      textColor: {r: 0, g: 0, b: 0, a: 0}
      imageContent: {fileID: 0}
      imageScale: 0
      anchoredPosition: {x: 44, y: 306}
  - clearType: 0
    targetGroups: []
    dialogueText: "\u305F\u3068\u3048\u3070\u3001<r=\u307F\u304E\u3066>\u53F3\u624B</r>\u3067\u30EA\u30F3\u30B4\u306E<r=\u3048>\u7D75</r>\u3092<r=\u304B>\u63CF</r>\u304D\u306A\u304C\u3089<br><r=\u3072\u3060\u308A\u3066>\u5DE6\u624B</r>\u3067\u30D0\u30CA\u30CA\u306E<r=\u3048>\u7D75</r>\u3092<r=\u304B>\u63CF</r>\u3053\u3046\u3068\u3059\u308B\u3068<r=>\u2026</r>"
    isFrogHandLowered: 0
    playChalkSound: 0
    newBoardItems: []
  - clearType: 0
    targetGroups: []
    dialogueText: "<r=\u3057\u3063\u3071\u3044>\u5931\u6557</r>\u3057\u305F\u30B1\u30ED\uFF01"
    isFrogHandLowered: 1
    playChalkSound: 1
    newBoardItems:
    - groupName: Content_1
      itemType: 1
      textContent: 
      fontSize: 0
      overrideColor: 0
      textColor: {r: 0, g: 0, b: 0, a: 0}
      imageContent: {fileID: 21300000, guid: 90bd5694dbdf9b84ba372916a0b31746, type: 3}
      imageScale: 3
      anchoredPosition: {x: -200, y: 58}
  - clearType: 0
    targetGroups: []
    dialogueText: "\u3084\u3063\u3071\u308A\u3001<r=\u3069\u3046\u3058>\u540C\u6642</r>\u306B\u3084\u308B\u3068<br><r=\u3046>\u4E0A</r><r=\u307E>\u624B</r>\u304F\u3044\u304B\u306A\u304B\u3063\u305F\u30B1\u30ED\u3002"
    isFrogHandLowered: 0
    playChalkSound: 0
    newBoardItems: []
  - clearType: 3
    targetGroups:
    - Title
    dialogueText: "\u3053\u3068\u308F\u3056\u306F<r=\u307B\u304B>\u4ED6</r>\u306B\u3082\u3044\u308D\u3044\u308D\u3042\u308B\u30B1\u30ED\u3002"
    isFrogHandLowered: 1
    playChalkSound: 0
    newBoardItems: []
  - clearType: 0
    targetGroups: []
    dialogueText: "\u304A\u3001<r=\u304A\u304A>\u591A</r>\u3044\u30B1\u30ED\u2026"
    isFrogHandLowered: 0
    playChalkSound: 1
    newBoardItems:
    - groupName: Content_2
      itemType: 0
      textContent: "\u30FB<r=\u3055\u308B>\u733F</r>\u3082<r=\u304D>\u6728</r>\u304B\u3089<r=\u304A>\u843D</r>\u3061\u308B\u2026<r=\u3058\u3087\u3046\u305A>\u4E0A\u624B</r>\u306A<r=\u3072\u3068>\u4EBA</r>\u3067\u3082<r=\u3057\u3063\u3071\u3044>\u5931\u6557</r>\u3059\u308B\u3053\u3068\u304C\u3042\u308B\u3053\u3068\u306E\u305F\u3068\u3048"
      fontSize: 36
      overrideColor: 0
      textColor: {r: 0, g: 0, b: 0, a: 0}
      imageContent: {fileID: 0}
      imageScale: 0
      anchoredPosition: {x: 44, y: 330}
    - groupName: Content_2
      itemType: 0
      textContent: "\u30FB<r=\u3044>\u4E95</r>\u306E<r=\u306A\u304B>\u4E2D</r>\u306E<r=\u304B\u308F\u305A>\u86D9</r><r=\u305F\u3044\u304B\u3044>\u5927\u6D77</r>\u3092<r=\u3057>\u77E5</r>\u3089\u305A\u2026<r=\u305B\u307E>\u72ED</r>\u3044<r=\u305B\u304B\u3044>\u4E16\u754C</r>\u306B\u3068\u3089\u308F\u308C\u3001<r=\u3072\u308D>\u5E83</r>\u3044<r=\u305B\u304B\u3044>\u4E16\u754C</r>\u3092<r=\u3057>\u77E5</r>\u3089\u306A\u3044\u3053\u3068\u306E\u305F\u3068\u3048"
      fontSize: 36
      overrideColor: 0
      textColor: {r: 0, g: 0, b: 0, a: 0}
      imageContent: {fileID: 0}
      imageScale: 0
      anchoredPosition: {x: 44, y: 245}
    - groupName: Content_2
      itemType: 0
      textContent: "\u30FB<r=\u306F\u3084>\u65E9</r><r=\u304A>\u8D77</r>\u304D\u306F<r=\u3055\u3093\u3082\u3093>\u4E09\u6587</r>\u306E<r=\u3068\u304F>\u5FB3</r>\u2026<r=\u3042\u3055\u306F\u3084>\u671D\u65E9</r>\u304F<r=\u304A>\u8D77</r>\u304D\u308B\u3068\u3001\u308F\u305A\u304B\u3067\u306F\u3042\u308B\u304C<r=\u3044>\u826F</r>\u3044\u3053\u3068\u304C<r=\u304A>\u8D77</r>\u3053\u308B\u3068\u3044\u3046<r=\u304A\u3057>\u6559</r>\u3048"
      fontSize: 36
      overrideColor: 0
      textColor: {r: 0, g: 0, b: 0, a: 0}
      imageContent: {fileID: 0}
      imageScale: 0
      anchoredPosition: {x: 44, y: 160}
    - groupName: Content_2
      itemType: 0
      textContent: "\u30FB<r=\u306D\u3053>\u732B</r>\u306B<r=\u3053\u3070\u3093>\u5C0F\u5224</r>\u2026<r=\u3053\u3046\u304B>\u9AD8\u4FA1</r>\u306A\u3082\u306E\u3067\u3082\u3001<r=\u304B\u3061>\u4FA1\u5024</r>\u304C<r=\u308F>\u5206</r>\u304B\u3089\u306A\u3044<r=\u3072\u3068>\u4EBA</r>\u306B<r=\u3042\u305F>\u4E0E</r>\u3048\u308B\u3068<r=\u3044>\u610F</r><r=\u307F>\u5473</r>\u304C<r=\u306A>\u7121</r>\u3044\u3053\u3068\u306E\u305F\u3068\u3048\n"
      fontSize: 36
      overrideColor: 0
      textColor: {r: 0, g: 0, b: 0, a: 0}
      imageContent: {fileID: 0}
      imageScale: 0
      anchoredPosition: {x: 44, y: 75}
    - groupName: Content_2
      itemType: 0
      textContent: "\u30FB<r=\u3044\u3057>\u77F3</r>\u306E<r=\u3046\u3048>\u4E0A</r>\u306B\u3082<r=\u3055\u3093\u306D\u3093>\u4E09\u5E74</r>\u2026\u3059\u3050\u306B<r=\u3051\u3063\u304B>\u7D50\u679C</r>\u304C<r=\u3067>\u51FA</r>\u306A\u3044\u3053\u3068\u3067\u3082\u3001\u304C\u307E\u3093<r=\u3065\u3088>\u5F37</r>\u304F<r=\u3057\u3093\u307C\u3046>\u8F9B\u62B1</r>\u3059\u308B\u3068<r=\u304F>\u5831</r>\u308F\u308C\u308B\u3068\u3044\u3046<r=\u304A\u3057>\u6559</r>\u3048\n"
      fontSize: 36
      overrideColor: 0
      textColor: {r: 0, g: 0, b: 0, a: 0}
      imageContent: {fileID: 0}
      imageScale: 0
      anchoredPosition: {x: 44, y: -10}
    - groupName: Content_2
      itemType: 0
      textContent: "\u30FB<r=\u3075\u304F\u3059\u3044>\u8986\u6C34</r><r=\u307C\u3093>\u76C6</r>\u306B<r=\u304B\u3048>\u8FD4</r>\u3089\u305A\u2026<r=\u3044\u3061\u3069>\u4E00\u5EA6</r><r=\u304A>\u8D77</r>\u304D\u3066\u3057\u307E\u3063\u305F\u3053\u3068\u306F<r=\u3082\u3068>\u5143</r>\u306B\u306F<r=\u3082\u3069>\u623B</r>\u3089\u306A\u3044\u3053\u3068\u306E\u305F\u3068\u3048"
      fontSize: 36
      overrideColor: 0
      textColor: {r: 0, g: 0, b: 0, a: 0}
      imageContent: {fileID: 0}
      imageScale: 0
      anchoredPosition: {x: 44, y: -95}
    - groupName: Content_2
      itemType: 0
      textContent: "\u30FB<r=\u306F\u306A>\u82B1</r>\u3088\u308A<r=\u3060\u3093\u3054>\u56E3\u5B50</r>\u2026<r=\u307F>\u898B</r>\u305F<r=\u3081>\u76EE</r>\u306E<r=\u3046\u3064\u304F>\u7F8E</r>\u3057\u3055\u3088\u308A\u3082<r=\u3058\u3064\u308A>\u5B9F\u5229</r>\u3092<r=\u3058\u3085\u3046\u3057>\u91CD\u8996</r>\u3059\u308B\u3053\u3068\u306E\u305F\u3068\u3048"
      fontSize: 36
      overrideColor: 0
      textColor: {r: 0, g: 0, b: 0, a: 0}
      imageContent: {fileID: 0}
      imageScale: 0
      anchoredPosition: {x: 44, y: -180}
  - clearType: 0
    targetGroups: []
    dialogueText: "\u3042\u3068\u306F\u3001<r=\u3044>\u610F</r><r=\u307F>\u5473</r>\u3060\u3051<r=\u3057\u3087\u3046\u304B\u3044>\u7D39\u4ECB</r>\u3059\u308B\u304B\u3089<br>\u307F\u3093\u306A\u3082<r=\u3050\u305F\u3044>\u5177\u4F53</r><r=\u308C\u3044>\u4F8B</r>\u3092<r=\u304B\u3093\u304C>\u8003</r>\u3048\u3066\u307F\u308B\u30B1\u30ED\u3002"
    isFrogHandLowered: 1
    playChalkSound: 0
    newBoardItems: []
  - clearType: 3
    targetGroups:
    - Title
    dialogueText: "\u3053\u3068\u308F\u3056\u306F\u307E\u3060\u307E\u3060\u3042\u308B\u30B1\u30ED\uFF01<color=#00000000><r=a>
      </r></color>"
    isFrogHandLowered: 0
    playChalkSound: 0
    newBoardItems: []
  - clearType: 0
    targetGroups: []
    dialogueText: "\u2026\u307E\u3041\u3001<r=\u3044\u3061\u3069>\u4E00\u5EA6</r>\u306B<r=\u305C\u3093\u3076>\u5168\u90E8</r><r=\u304A\u307C>\u899A</r>\u3048\u3088\u3046\u3068\u3057\u306A\u304F\u3066\u3082<br><r=\u3060\u3044\u3058\u3087\u3046\u3076>\u5927\u4E08\u592B</r>\u30B1\u30ED\uFF01"
    isFrogHandLowered: 1
    playChalkSound: 1
    newBoardItems:
    - groupName: Content_3
      itemType: 0
      textContent: "\u30FB<r=\u3057>\u77E5</r>\u3089\u306C\u304C<r=\u307B\u3068\u3051>\u4ECF</r>\u2026<r=\u3057>\u77E5</r>\u3089\u306A\u3044\u307E\u307E\u3067\u3044\u305F\u307B\u3046\u304C\u3001<r=\u3053\u3053\u308D>\u5FC3</r>\u306E<r=\u3078\u3044\u305B\u3044>\u5E73\u9759</r>\u3092<r=\u305F\u3082>\u4FDD</r>\u3063\u3066\u3044\u3089\u308C\u308B\u3053\u3068\u304C\u3042\u308B\u3068\u3044\u3046<r=\u304A\u3057>\u6559</r>\u3048"
      fontSize: 36
      overrideColor: 0
      textColor: {r: 0, g: 0, b: 0, a: 0}
      imageContent: {fileID: 0}
      imageScale: 0
      anchoredPosition: {x: 44, y: 330}
    - groupName: Content_3
      itemType: 0
      textContent: "\u30FB<r=\u3044\u305D>\u6025</r>\u304C\u3070<r=\u307E\u308F>\u56DE</r>\u308C\u2026<r=\u3068\u304A\u307E\u308F>\u9060\u56DE</r>\u308A\u3067\u3082<r=\u304B\u304F\u3058\u3064>\u78BA\u5B9F</r>\u306A<r=\u307B\u3046\u307B\u3046>\u65B9\u6CD5</r>\u3092<r=\u3048\u3089>\u9078</r>\u3093\u3060<r=\u307B\u3046>\u65B9</r>\u304C\u3001<r=\u3051\u3063\u304B\u3066\u304D>\u7D50\u679C\u7684</r>\u306B<r=\u306F\u3084>\u65E9</r>\u3044\u3053\u3068\u304C\u3042\u308B\u3068\u3044\u3046<r=\u304A\u3057>\u6559</r>\u3048"
      fontSize: 36
      overrideColor: 0
      textColor: {r: 0, g: 0, b: 0, a: 0}
      imageContent: {fileID: 0}
      imageScale: 0
      anchoredPosition: {x: 44, y: 245}
    - groupName: Content_3
      itemType: 0
      textContent: "\u30FB<r=\u304D>\u805E</r>\u304F\u306F<r=\u3044\u3063\u3068\u304D>\u4E00\u6642</r>\u306E<r=\u306F\u3058>\u6065</r>\u3001<r=\u304D>\u805E</r>\u304B\u306C\u306F<r=\u3044\u3063\u3057\u3087\u3046>\u4E00\u751F</r>\u306E<r=\u306F\u3058>\u6065</r>\u2026<r=\u306F>\u6065</r>\u305A\u304B\u3057\u304F\u3066\u3082<r=\u3057>\u77E5</r>\u3089\u306A\u3044\u3053\u3068\u306F<r=\u304D>\u805E</r>\u3044\u305F<r=\u307B\u3046>\u65B9</r>\u304C<r=\u3088>\u826F</r>\u3044\u3068\u3044\u3046<r=\u304A\u3057>\u6559</r>\u3048"
      fontSize: 36
      overrideColor: 0
      textColor: {r: 0, g: 0, b: 0, a: 0}
      imageContent: {fileID: 0}
      imageScale: 0
      anchoredPosition: {x: 44, y: 160}
    - groupName: Content_3
      itemType: 0
      textContent: "\u30FB<r=\u3042\u3081>\u96E8</r><r=\u3075>\u964D</r>\u3063\u3066<r=\u3058>\u5730</r><r=\u304B\u305F>\u56FA</r>\u307E\u308B\u2026<r=\u308F\u308B>\u60AA</r>\u3044\u3053\u3068\u304C<r=\u304A>\u8D77</r>\u304D\u305F\u3042\u3068\u3001\u304B\u3048\u3063\u3066<r=\u307E\u3048>\u524D</r>\u3088\u308A\u3082<r=\u3088>\u826F</r>\u3044<r=\u3058\u3087\u3046\u305F\u3044>\u72B6\u614B</r>\u306B\u306A\u308B\u3053\u3068\u306E\u305F\u3068\u3048"
      fontSize: 36
      overrideColor: 0
      textColor: {r: 0, g: 0, b: 0, a: 0}
      imageContent: {fileID: 0}
      imageScale: 0
      anchoredPosition: {x: 44, y: 75}
    - groupName: Content_3
      itemType: 0
      textContent: "\u30FB<r=\u305F\u306A>\u68DA</r>\u304B\u3089\u307C\u305F<r=\u3082\u3061>\u9905</r>\u2026<r=\u304A\u3082>\u601D</r>\u3044\u304C\u3051\u306A\u3044<r=\u3053\u3046\u3046\u3093>\u5E78\u904B</r>\u306B<r=\u3081\u3050>\u6075</r>\u307E\u308C\u308B\u3053\u3068\u306E\u305F\u3068\u3048"
      fontSize: 36
      overrideColor: 0
      textColor: {r: 0, g: 0, b: 0, a: 0}
      imageContent: {fileID: 0}
      imageScale: 0
      anchoredPosition: {x: 44, y: -10}
    - groupName: Content_3
      itemType: 0
      textContent: "\u30FB<r=\u3055\u308B>\u733F</r>\u306E<r=\u3057\u308A\u308F\u3089>\u5C3B\u7B11</r>\u3044\u2026<r=\u3058\u3076\u3093>\u81EA\u5206</r>\u306E<r=\u3051\u3063\u3066\u3093>\u6B20\u70B9</r>\u3092<r=\u305F\u306A>\u68DA</r>\u306B<r=\u3042>\u4E0A</r>\u3052\u3066\u3001<r=\u305F\u306B\u3093>\u4ED6\u4EBA</r>\u306E<r=\u3051\u3063\u3066\u3093>\u6B20\u70B9</r>\u3092<r=\u308F\u3089>\u7B11</r>\u3046\u3053\u3068\u306E\u305F\u3068\u3048"
      fontSize: 36
      overrideColor: 0
      textColor: {r: 0, g: 0, b: 0, a: 0}
      imageContent: {fileID: 0}
      imageScale: 0
      anchoredPosition: {x: 44, y: -95}
    - groupName: Content_3
      itemType: 0
      textContent: "\u30FB<r=\u3053\u308D>\u8EE2</r>\u3070\u306C<r=\u3055\u304D>\u5148</r>\u306E<r=\u3064\u3048>\u6756</r>\u2026<r=\u3057\u3063\u3071\u3044>\u5931\u6557</r>\u3092\u3057\u306A\u3044\u3088\u3046\u306B<r=\u307E\u3048>\u524D</r>\u3082\u3063\u3066<r=\u3058\u3085\u3093\u3073>\u6E96\u5099</r>\u3057\u3066\u304A\u304F\u3053\u3068\u306E\u305F\u3068\u3048"
