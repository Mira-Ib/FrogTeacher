    targetGroups: []
    dialogueText: "<r=\u304D\u3087\u3046>\u4ECA\u65E5</r><r=\u3057\u3087\u3046\u304B\u3044>\u7D39\u4ECB</r>\u3059\u308B\u306E\u306F\u3053\u308C\u3067<r=\u305C\u3093\u3076>\u5168\u90E8</r>\u30B1\u30ED\u3002"
    isFrogHandLowered: 0
    playChalkSound: 0
    newBoardItems: []
  - clearType: 0
    targetGroups: []
    dialogueText: "<r=\u3057>\u77E5</r>\u3063\u3066\u308B<r=\u3053\u3068\u3070>\u8A00\u8449</r>\u3067\u3082\u3001<r=\u3050\u305F\u3044\u308C\u3044>\u5177\u4F53\u4F8B</r>\u3092<r=\u304B\u3093\u304C>\u8003</r>\u3048\u308B\u3068<br><r=\u3042\u3089>\u65B0</r>\u305F\u306A<r=\u306F\u3063\u3051\u3093>\u767A\u898B</r>\u304C\u3042\u308B\u304B\u3082\u3057\u308C\u306A\u3044\u30B1\u30ED\uFF01"
    isFrogHandLowered: 1
    playChalkSound: 0
    newBoardItems: []
  - clearType: 0
