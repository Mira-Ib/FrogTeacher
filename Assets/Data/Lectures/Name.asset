  steps:
  - dialogueText: "\u305D\u308C\u3058\u3083\u3042\u3001<r=\u304D\u3087\u3046>\u4ECA\u65E5</r>\u306F\u305F\u3057<r=\u3056\u3093>\u7B97</r>\u306B\u3064\u3044\u3066<br><r=\u305B\u3064\u3081\u3044>\u8AAC\u660E</r>\u3057\u3066\u3044\u304F\u30B1\u30ED\u3002"
    isFrogHandLowered: 0
    playChalkSound: 1
    newBoardItems:
    - itemType: 0
      textContent: "<u>\u305F\u3057<r=\u3056\u3093>\u7B97</r></u>"
      fontSize: 64
      overrideColor: 0
      textColor: {r: 1, g: 1, b: 1, a: 0}
      imageContent: {fileID: 0}
      imageScale: 0
      anchoredPosition: {x: 87, y: 431}
  - dialogueText: "\u305F\u3057<r=\u3056\u3093>\u7B97</r>\u3092<r=\u3072\u3068\u3053\u3068>\u4E00\u8A00</r>\u3067<r=\u3042\u3089\u308F>\u8868</r>\u3059\u3068\u2026<br>\u307E\u3068\u3081\u3066\u3044\u304F\u3064\u306B\u306A\u308B\u304B\u3092<r=\u304B\u305E>\u6570</r>\u3048\u308B<r=\u3051\u3044\u3055\u3093>\u8A08\u7B97</r>\u30B1\u30ED\u3002"
    isFrogHandLowered: 1
    playChalkSound: 1
    newBoardItems:
    - itemType: 0
      textContent: "\u305F\u3057<r=\u3056\u3093>\u7B97</r>\u306F\u3001\u307E\u3068\u3081\u3066\u3044\u304F\u3064\u306B\u306A\u308B\u304B\u3092<r=\u304B\u305E>\u6570</r>\u3048<r=\u3042>\u4E0A</r>\u3052\u308B<r=\u3051\u3044\u3055\u3093>\u8A08\u7B97</r>"
      fontSize: 56
      overrideColor: 0
      textColor: {r: 1, g: 1, b: 1, a: 0}
      imageContent: {fileID: 0}
      imageScale: 0
      anchoredPosition: {x: 87, y: 293}
  - dialogueText: "\u305F\u3068\u3048\u3070\u3001\u300C\u30C1\u30E7\u30AD\u300D\u3068\u300C\u30D1\u30FC\u300D\u306E<color=#00000000><r=a>
