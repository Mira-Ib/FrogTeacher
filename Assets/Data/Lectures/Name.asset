  - dialogueText: "<r=\u305C\u3093\u3076>\u5168\u90E8</r>\u307E\u3068\u3081\u308B\u30687<r=\u307B\u3093>\u672C</r>\u306B\u306A\u308B\u30B1\u30ED\u3002"
    isFrogHandLowered: 1
    playChalkSound: 1
    newBoardItems:
    - itemType: 0
      textContent: "<r=\u305C\u3093\u3076>\u5168\u90E8</r>\u3067 7 <r=\u307B\u3093>\u672C</r>"
      fontSize: 56
      overrideColor: 0
      textColor: {r: 0, g: 0, b: 0, a: 0}
      imageContent: {fileID: 0}
      imageScale: 0
      anchoredPosition: {x: 883, y: 31}
  - dialogueText: "\u305D\u3057\u3066\u3001\u3053\u308C\u3092\u305F\u3057<r=\u3056\u3093>\u7B97</r>\u306E<r=\u3044>\u610F</r><r=\u307F>\u5473</r>\u3067<r=\u304B\u3093\u304C>\u8003</r>\u3048\u308B\u3068\u3001<br>2+5=7
      \u3068\u3044\u3046\u3053\u3068\u306B\u306A\u308B\u30B1\u30ED\u3002"
    isFrogHandLowered: 0
    playChalkSound: 1
    newBoardItems:
    - itemType: 0
      textContent: <b>2   +   5    =   7</b>
      fontSize: 80
      overrideColor: 1
      textColor: {r: 1, g: 1, b: 0, a: 1}
      imageContent: {fileID: 0}
      imageScale: 0
      anchoredPosition: {x: 200, y: -185}
  - dialogueText: "<r=\u304B\u305A>\u6570</r>\u304C<r=\u304A\u304A>\u5927</r>\u304D\u304F\u306A\u3063\u305F\u3068\u3057\u3066\u3082\u3001<br>\u305F\u3057<r=\u3056\u3093>\u7B97</r>\u3068\u3044\u3046<r=\u3051\u3044\u3055\u3093>\u8A08\u7B97</r>\u306E<r=\u3044>\u610F</r><r=\u307F>\u5473</r>\u306F<r=\u304A\u306A>\u540C</r>\u3058\u30B1\u30ED\u3002"
    isFrogHandLowered: 1
    playChalkSound: 0
    newBoardItems: []
  - dialogueText: "<r=\u3055\u3044\u3054>\u6700\u5F8C</r>\u306B\u3082\u3046<r=\u3044\u3061\u3069>\u4E00\u5EA6</r><r=\u3044>\u8A00</r>\u3063\u3066\u304A\u304F\u30B1\u30ED\u3002"
    isFrogHandLowered: 0
    playChalkSound: 0
    newBoardItems: []
  - dialogueText: "\u305F\u3057<r=\u3056\u3093>\u7B97</r>\u306F\u3001\u307E\u3068\u3081\u3066\u3044\u304F\u3064\u306B\u306A\u308B\u304B\u3092<br><r=\u304B\u305E>\u6570</r>\u3048<r=\u3042>\u4E0A</r>\u3052\u308B<r=\u3051\u3044\u3055\u3093>\u8A08\u7B97</r>\u306A\u3093\u3060\u30B1\u30ED\u3002"
    isFrogHandLowered: 1
    playChalkSound: 1
    newBoardItems:
    - itemType: 1
      textContent: 
