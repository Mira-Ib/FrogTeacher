  steps:
  - clearType: 0
    targetGroups: []
    dialogueText: "\u305D\u308C\u3058\u3083\u3042\u3001<r=\u304D\u3087\u3046>\u4ECA\u65E5</r>\u306F<r=\u304B\u304F\u308A\u3064>\u78BA\u7387</r>\u306B\u3064\u3044\u3066<br><r=\u305B\u3064\u3081\u3044>\u8AAC\u660E</r>\u3057\u3066\u3044\u304F\u30B1\u30ED\u3002"
    isFrogHandLowered: 0
    playChalkSound: 1
    newBoardItems:
    - groupName: Title
      itemType: 0
      textContent: "<u><r=\u304B\u304F\u308A\u3064>\u78BA\u7387</r></u>"
      fontSize: 64
      overrideColor: 0
      textColor: {r: 0, g: 0, b: 0, a: 0}
      imageContent: {fileID: 0}
      imageScale: 0
      anchoredPosition: {x: 87, y: 431}
  - clearType: 0
    targetGroups: []
    dialogueText: "<r=\u304B\u304F\u308A\u3064>\u78BA\u7387</r>\u3068\u306F\u3001<r=\u3067>\u51FA</r><r=\u304D>\u6765</r><r=\u3054\u3068>\u4E8B</r>\u306E<r=\u304A>\u8D77</r>\u3053\u308A\u3084\u3059\u3055\u3092<br><r=\u3042\u3089\u308F>\u8868</r>\u3059<r=\u3059\u3046\u3061>\u6570\u5024</r>\u30B1\u30ED\u3002"
    isFrogHandLowered: 1
    playChalkSound: 1
    newBoardItems:
    - groupName: Content_1
      itemType: 0
      textContent: "<r=\u304B\u304F\u308A\u3064>\u78BA\u7387</r>\u3000\u2026\u3000<r=\u3067>\u51FA</r><r=\u304D>\u6765</r><r=\u3054\u3068>\u4E8B</r>\u306E<r=\u304A>\u8D77</r>\u3053\u308A\u3084\u3059\u3055\u3092<r=\u3042\u3089\u308F>\u8868</r>\u3059<r=\u3042\u305F\u3044>\u5024</r>\uFF080\uFF5E1\uFF09"
      fontSize: 48
      overrideColor: 0
      textColor: {r: 0, g: 0, b: 0, a: 0}
      imageContent: {fileID: 0}
      imageScale: 0
      anchoredPosition: {x: 87, y: 314}
    - groupName: Content_1
      itemType: 1
      textContent: 
      fontSize: 0
      overrideColor: 0
      textColor: {r: 0, g: 0, b: 0, a: 0}
      imageContent: {fileID: 21300000, guid: bbc36172a7e932e49b542b0ef1eb195c, type: 3}
      imageScale: 0
      anchoredPosition: {x: -464, y: 189}
    - groupName: Content_1
      itemType: 1
      textContent: 
      fontSize: 0
      overrideColor: 0
      textColor: {r: 0, g: 0, b: 0, a: 0}
      imageContent: {fileID: 21300000, guid: 9e9a7bc749ecddb43bbdec3deeed0588, type: 3}
      imageScale: 0
      anchoredPosition: {x: -186, y: 186}
  - clearType: 0
    targetGroups: []
    dialogueText: "<r=\u304B\u304F\u308A\u3064>\u78BA\u7387</r>\u304C1\u306E\u3053\u3068\u306F<r=\u305C\u3063\u305F\u3044>\u7D76\u5BFE</r>\u306B<r=\u304A>\u8D77</r>\u3053\u3063\u3066\u3001<br>0\u306E\u3053\u3068\u306F<r=\u305C\u3063\u305F\u3044>\u7D76\u5BFE</r>\u306B<r=\u304A>\u8D77</r>\u3053\u3089\u306A\u3044\u30B1\u30ED\u3002"
    isFrogHandLowered: 0
    playChalkSound: 0
    newBoardItems: []
  - clearType: 0
    targetGroups: []
    dialogueText: "\u305F\u3068\u3048\u3070\u3001\u30B3\u30A4\u30F3\u3092<r=\u306A>\u6295</r>\u3052\u3066\u3001<br><r=\u304A\u3082\u3066>\u8868</r>\u304C<r=\u3067>\u51FA</r>\u308B<r=\u304B\u304F\u308A\u3064>\u78BA\u7387</r>\u306F1/2\u30B1\u30ED\u3002"
    isFrogHandLowered: 1
    playChalkSound: 0
    newBoardItems: []
  - clearType: 0
    targetGroups: []
    dialogueText: "\u30B3\u30A4\u30F3\u3092<r=\u306A\u3093\u3069>\u4F55\u5EA6</r>\u3082<r=\u306A>\u6295</r>\u3052\u308B\u3068\u3001\u305D\u306E<r=\u306A\u304B>\u4E2D</r>\u3067<br><r=\u304A\u3082\u3066>\u8868</r>\u304C<r=\u3067>\u51FA</r>\u305F<r=\u308F\u308A\u3042\u3044>\u5272\u5408</r>\u306F1/2\u306B<r=\u3061\u304B>\u8FD1</r>\u3065\u3044\u3066\u3044\u304F\u30B1\u30ED\u3002"
    isFrogHandLowered: 0
    playChalkSound: 0
    newBoardItems: []
  - clearType: 0
    targetGroups: []
    dialogueText: "\u305F\u3068\u3048\u3070\u3001<r=\u3044\u3061\u307E\u3093\u304B\u3044>\u4E00\u4E07\u56DE</r>\u306E<r=\u3057\u3053\u3046>\u8A66\u884C</r>\u30674500<r=\u304B\u3044\u3044\u3058\u3087\u3046>\u56DE\u4EE5\u4E0A</r><br>5500<r=\u304B\u3044>\u56DE</r><r=\u3044\u304B>\u4EE5\u4E0B</r><r=\u304A\u3082\u3066>\u8868</r>\u304C<r=\u3067>\u51FA</r>\u308B<r=\u304B\u304F\u308A\u3064>\u78BA\u7387</r>\u306F\u307B\u307C100\uFF05\u30B1\u30ED\u3002"
    isFrogHandLowered: 1
    playChalkSound: 0
    newBoardItems: []
  - clearType: 0
    targetGroups: []
    dialogueText: "<r=\u306F\u3093\u3076\u3093>\u534A\u5206</r>\u306E5000<r=\u304B\u3044>\u56DE</r>\u3068\u306E<r=\u3054>\u8AA4</r><r=\u3055>\u5DEE</r>\u304C<r=\u3078>\u6E1B</r>\u3063\u3066\u3044\u304F\u3001<br>\u3068\u3044\u3046<r=\u3044>\u610F</r><r=\u307F>\u5473</r>\u3067\u306F\u306A\u3044\u3053\u3068\u306B<r=\u3061\u3085\u3046\u3044>\u6CE8\u610F</r>\u3059\u308B\u30B1\u30ED\u3002"
    isFrogHandLowered: 0
    playChalkSound: 0
    newBoardItems: []
  - clearType: 0
    targetGroups: []
    dialogueText: "<r=\u308C\u3093\u305E\u304F>\u9023\u7D9A</r>\u3067<r=\u304A\u3082\u3066>\u8868</r>\u304C<r=\u3067>\u51FA</r>\u305F\u304B\u3089<r=\u3064\u304E>\u6B21</r>\u306F<r=\u3046\u3089>\u88CF</r>\u304C<r=\u3067>\u51FA</r>\u3084\u3059\u3044<br>\u306A\u3093\u3066\u3053\u3068\u306F\u306A\u3044\u30B1\u30ED\u3002<color=#00000000><r=a></r></color>"
    isFrogHandLowered: 1
    playChalkSound: 0
    newBoardItems: []
  - clearType: 0
    targetGroups: []
    dialogueText: "\u3061\u306A\u307F\u306B\u3001<r=\u3067>\u51FA</r><r=\u304D>\u6765</r><r=\u3054\u3068>\u4E8B</r>\u306E<r=\u304A>\u8D77</r>\u3053\u308B<r=\u304B\u304F\u308A\u3064>\u78BA\u7387</r>\u304C<r=\u3072\u3068>\u7B49</r>\u3057\u3044\u3068\u304D<br>\u3053\u308C\u3092\u300C<r=\u3069\u3046\u3088\u3046>\u540C\u69D8</r>\u306B<r=\u305F\u3057>\u78BA</r>\u304B\u3089\u3057\u3044\u300D\u3068\u3044\u3046\u30B1\u30ED\u3002"
    isFrogHandLowered: 0
    playChalkSound: 1
    newBoardItems:
    - groupName: Content_1
      itemType: 0
      textContent: "<r=\u3069\u3046\u3088\u3046>\u540C\u69D8</r>\u306B<r=\u305F\u3057>\u78BA</r>\u304B\u3089\u3057\u3044\u3000\u2026\u3000<r=\u3067>\u51FA</r><r=\u304D>\u6765</r><r=\u3054\u3068>\u4E8B</r>\u306E<r=\u304A>\u8D77</r>\u3053\u308B<r=\u304B\u304F\u308A\u3064>\u78BA\u7387</r>\u304C<r=\u304A\u306A>\u540C</r>\u3058"
      fontSize: 48
      overrideColor: 0
      textColor: {r: 0, g: 0, b: 0, a: 0}
      imageContent: {fileID: 0}
      imageScale: 0
      anchoredPosition: {x: 87, y: 11}
  - clearType: 0
    targetGroups: []
    dialogueText: "<r=\u3075\u3064\u3046>\u666E\u901A</r>\u306E\u30B3\u30A4\u30F3\u3084\u30B5\u30A4\u30B3\u30ED\u306E<r=\u3067\u304B\u305F>\u51FA\u65B9</r>\u306F<br><r=\u3069\u3046\u3088\u3046>\u540C\u69D8</r>\u306B<r=\u305F\u3057>\u78BA</r>\u304B\u3089\u3057\u3044\u3068<r=\u304B\u3093\u304C>\u8003</r>\u3048\u308B\u3053\u3068\u304C<r=\u304A\u304A>\u591A</r>\u3044\u30B1\u30ED\u3002"
    isFrogHandLowered: 1
    playChalkSound: 1
    newBoardItems:
    - groupName: Content_1
      itemType: 0
      textContent: "<r=\u308C\u3044>\u4F8B</r>\uFF09<color=red>\u3007</color>\u30B3\u30A4\u30F3\u3001\u30B5\u30A4\u30B3\u30ED\u306E<r=\u3067>\u51FA</r><r=\u304B\u305F>\u65B9</r>"
      fontSize: 48
      overrideColor: 0
      textColor: {r: 0, g: 0, b: 0, a: 0}
      imageContent: {fileID: 0}
      imageScale: 0
      anchoredPosition: {x: 87, y: -85}
  - clearType: 0
    targetGroups: []
    dialogueText: "\u3067\u3082\u3001<r=\u3042\u3057\u305F>\u660E\u65E5</r>\u306E<r=\u3066\u3093\u304D>\u5929\u6C17</r>\u3068\u304B\u306F<br><r=\u3069\u3046\u3088\u3046>\u540C\u69D8</r>\u306B<r=\u305F\u3057>\u78BA</r>\u304B\u3089\u3057\u304F\u306A\u3044\u30B1\u30ED\u3002"
    isFrogHandLowered: 0
    playChalkSound: 1
    newBoardItems:
    - groupName: Content_1
      itemType: 0
      textContent: "<color=red>\xD7</color> <r=\u3042\u3057\u305F>\u660E\u65E5</r>\u306E<r=\u3066\u3093\u304D>\u5929\u6C17</r>\uFF08<r=\u306F>\u6674</r>\u308C
        or \u304F\u3082\u308A or <r=\u3042\u3081>\u96E8</r>\uFF09"
      fontSize: 48
      overrideColor: 0
      textColor: {r: 0, g: 0, b: 0, a: 0}
      imageContent: {fileID: 0}
      imageScale: 0
      anchoredPosition: {x: 188, y: -170}
  - clearType: 0
    targetGroups: []
    dialogueText: "<r=\u304B\u304F\u308A\u3064>\u78BA\u7387</r>\u3092<r=\u3082\u3068>\u6C42</r>\u3081\u305F\u3044\u3068\u304D\u306B\u306F\u3001<r=\u306A\u306B>\u4F55</r>\u304C<r=\u3069\u3046\u3088\u3046>\u540C\u69D8</r>\u306B<br><r=\u305F\u3057>\u78BA</r>\u304B\u3089\u3057\u3044\u304B\u3092<r=\u307F>\u898B</r><r=\u306C>\u629C</r>\u304F\u306E\u304C<r=\u3060\u3044\u3058>\u5927\u4E8B</r>\u30B1\u30ED\u3002"
    isFrogHandLowered: 1
    playChalkSound: 0
    newBoardItems: []
  - clearType: 0
    targetGroups: []
    dialogueText: "\u307F\u3093\u306A\u3001<r=\u308F>\u5206</r>\u304B\u3063\u305F\u30B1\u30ED\uFF1F"
    isFrogHandLowered: 0
    playChalkSound: 0
    newBoardItems: []
